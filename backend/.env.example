# Copy this file to ".env" (same folder) and fill in your key.
# NEVER commit the real .env file. It is listed in .gitignore.

# Get a free key at https://console.groq.com/keys (paste it here, never in code or chat).
GROQ_API_KEY=

# Model used for the AI analyst. It MUST support tool calling.
# Default: openai/gpt-oss-120b (production model with tool use). Cheaper/faster: openai/gpt-oss-20b.
# Check what your key can use:  python -m scripts.check_groq
GROQ_MODEL=openai/gpt-oss-120b

# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload limit in megabytes
MAX_UPLOAD_MB=25

# Chat requests allowed per minute per client IP
CHAT_RATE_LIMIT_PER_MIN=20
